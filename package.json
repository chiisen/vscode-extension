{
	"name": "vscode-extension-hello-world",
	"displayName": "vscode-extension-hello-world",
	"description": "vscode extension hello world",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.65.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:extension.help",
		"onCommand:extension.createComponent",
		"onCommand:extension.createNote"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.help",
				"title": "⚠extension.help",
				"category": "VSCode Extension 功能說明"
			},
			{
				"command": "extension.createComponent",
				"title": "🤡extension.createComponent->Title",
				"category": "Files and Folder"
			},
			{
				"command": "extension.createNote",
				"title": "📝 建立筆記",
				"category": "Notes"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "extension.help",
					"group": "navigation"
				},
				{
					"command": "extension.createComponent",
					"group": "navigation"
				},
				{
					"command": "extension.createNote",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "extension.help",
					"group": "navigation"
				},
				{
					"command": "extension.createComponent",
					"group": "navigation"
				},
				{
					"command": "extension.createNote",
					"group": "navigation"
				}
			]
		},
		"keybindings": [
			{
				"command": "extension.help",
				"key": "ctrl+alt+n"
			},
			{
				"command": "extension.createComponent",
				"key": "ctrl+alt+o"
			},
			{
				"command": "extension.createNote",
				"key": "ctrl+alt+m"
			}
		],
		"configuration": {
			"title": "VSCode Extension Notes",
			"properties": {
				"vscodeExtension.notePath": {
					"type": "string",
					"default": "~/notes",
					"description": "筆記存放位置"
				}
			}
		}
	},
"scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js"
  },
	"repository": {
		"type": "git",
		"url": "https://github.com/chiisen/vscode-extension"
	},
	"devDependencies": {
		"@types/glob": "^7.2.0",
		"@types/mocha": "^9.1.0",
		"@types/node": "^14.18.63",
		"@types/vscode": "^1.93.0",
		"@typescript-eslint/eslint-plugin": "^5.12.1",
		"@typescript-eslint/parser": "^5.12.1",
		"@vscode/test-electron": "^2.1.2",
		"eslint": "^8.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"glob": "^7.2.0",
		"mocha": "^9.2.1",
		"prettier": "^3.8.1",
		"typescript": "^4.5.5",
		"vscode": "^1.1.37"
	},
	"publisher": "vscode-extension-hello-world-1221"
}
